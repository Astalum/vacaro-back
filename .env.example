API_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=vacaro
POSTGRES_USER=vacaro
POSTGRES_PASSWORD=vacaro
SESSION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
SESSION_COOKIE_SECURE=false
GUEST_TTL=168h
REGISTERED_SESSION_TTL=720h
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated browser origins allowed to perform state-changing requests.
# Defaults to the origin of PUBLIC_APP_URL when empty.
ALLOWED_ORIGINS=
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW=1m
# Set this only to the CIDRs of reverse proxies that connect directly to the API.
# Example for a fixed private proxy network: TRUSTED_PROXY_CIDRS=10.20.0.0/16
TRUSTED_PROXY_CIDRS=

# Google integration (set all values to enable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_LOGIN_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# GOOGLE_CALENDAR_REDIRECT_URL=http://localhost:8080/api/v1/integrations/google-calendar/callback
GOOGLE_LOGIN_REDIRECT_URL=
GOOGLE_CALENDAR_REDIRECT_URL=
# Generate a different key from SESSION_KEY with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
